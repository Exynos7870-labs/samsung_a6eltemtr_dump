<favorites xmlns:launcher="http://schemas.android.com/apk/res/com.sec.android.app.launcher">

    <home>
        <!-- appwidget : Weather -->
        <appwidget 
            launcher:screen="0" 
            launcher:packageName="com.sec.android.daemonapp" 
            launcher:className="com.sec.android.daemonapp.appwidget.WeatherAppWidget2x1" 
            launcher:x="1" 
            launcher:y="0" 
            launcher:spanX="3" 
            launcher:spanY="3" />

        <!-- appwidget : Google -->
        <appwidget 
            launcher:screen="0" 
            launcher:packageName="com.google.android.googlequicksearchbox" 
            launcher:className="com.google.android.googlequicksearchbox.SearchWidgetProvider" 
            launcher:x="0" 
            launcher:y="3" 
            launcher:spanX="5" 
            launcher:spanY="1" />

        <!-- Email -->
        <favorite 
            launcher:screen="0" 
            launcher:packageName="com.samsung.android.email.provider" 
            launcher:className="com.samsung.android.email.ui.activity.MessageListXL" 
            launcher:x="0" 
            launcher:y="4" />

        <!-- Calendar -->
        <favorite 
            launcher:screen="0" 
            launcher:packageName="com.samsung.android.calendar" 
            launcher:className="com.android.calendar.AllInOneActivity" 
            launcher:x="1" 
            launcher:y="4" />

        <!-- Gallery -->
        <favorite 
            launcher:screen="0" 
            launcher:packageName="com.sec.android.gallery3d" 
            launcher:className="com.sec.android.gallery3d.app.GalleryOpaqueActivity" 
            launcher:x="2" 
            launcher:y="4" />

        <!-- Google Play Store -->
        <favorite 
            launcher:screen="0" 
            launcher:packageName="com.android.vending" 
            launcher:className="com.android.vending.AssetBrowserActivity" 
            launcher:x="3" 
            launcher:y="4" />

        <!-- folder : Google -->
        <folder 
            launcher:screen="0" 
            launcher:title="Google" 
            launcher:x="4" 
            launcher:y="4">
            <!-- Google -->
            <favorite 
                launcher:screen="0" 
                launcher:packageName="com.google.android.googlequicksearchbox" 
                launcher:className="com.google.android.googlequicksearchbox.SearchActivity" />
            <!-- Gmail -->
            <favorite 
                launcher:screen="1" 
                launcher:packageName="com.google.android.gm" 
                launcher:className="com.google.android.gm.ConversationListActivityGmail" />
            <!-- Maps -->
            <favorite 
                launcher:screen="2" 
                launcher:packageName="com.google.android.apps.maps" 
                launcher:className="com.google.android.maps.MapsActivity" />
            <!-- YouTube -->
            <favorite 
                launcher:screen="3" 
                launcher:packageName="com.google.android.youtube" 
                launcher:className="com.google.android.youtube.app.honeycomb.Shell$HomeActivity" />
            <!-- Drive -->
            <favorite 
                launcher:screen="4" 
                launcher:packageName="com.google.android.apps.docs" 
                launcher:className="com.google.android.apps.docs.app.NewMainProxyActivity" />
            <!-- Google Play Music -->
            <favorite 
                launcher:screen="5" 
                launcher:packageName="com.google.android.music" 
                launcher:className="com.android.music.activitymanagement.TopLevelActivity" />
            <!-- Google Play Movies & TV -->
            <favorite 
                launcher:screen="6" 
                launcher:packageName="com.google.android.videos" 
                launcher:className="com.google.android.youtube.videos.EntryPoint" />
            <!-- Duo -->
            <favorite 
                launcher:screen="7" 
                launcher:packageName="com.google.android.apps.tachyon" 
                launcher:className="com.google.android.apps.tachyon.MainActivity" />
            <!-- Photos -->
            <favorite
                launcher:screen="8" 
                launcher:packageName="com.google.android.apps.photos" 
                launcher:className="com.google.android.apps.photos.home.HomeActivity" />
            <!-- Google Pay -->
            <favorite 
                launcher:screen="9" 
                launcher:packageName="com.google.android.apps.walletnfcrel" 
                launcher:className="com.google.commerce.tapandpay.android.cardlist.CardListActivity" />
            <!-- Google One -->
            <favorite 
                launcher:screen="10" 
                launcher:packageName="com.google.android.apps.subscriptions.red" 
                launcher:className="com.google.android.apps.subscriptions.red.LauncherActivity" />
        </folder>

        <!--  screen [1]  -->
        <!-- com.mobileposse.client.mp5.lib.newsreader.ui.MobitilesWidgetProvider -->
        <appwidget
            launcher:packageName="com.metropcs.metrozone" 
            launcher:className="com.mobileposse.client.mp5.lib.newsreader.ui.WidgetProviderResizable" 
            launcher:screen="1" 
            launcher:x="0" 
            launcher:y="0" 
            launcher:spanX="5" 
            launcher:spanY="2" />
			
        <!-- myMetro -->
        <favorite
            launcher:screen="1" 
            launcher:packageName="com.nuance.nmc.sihome.metropcs" 
            launcher:className="com.nuance.nmc.sihome.metropcs.myMetro"
            launcher:x="0" 
            launcher:y="4" 			/>

        <!-- Folder : MetroPCS Folder -->
        <folder
            launcher:screen="1" 
            launcher:title="MetroPCS Folder" 
            launcher:x="1" 
            launcher:y="4" >
            <!-- AppStore -->
            <favorite
                launcher:screen="0" 
                launcher:packageName="com.handmark.metro.launcher" 
                launcher:className="com.handmark.metro.launcher.Launcher" />
            <!-- Device Unlock -->
			<favorite
				launcher:screen="1" 
				launcher:packageName="com.metro.simlock" 
				launcher:className="com.metro.simlock.WelcomeActivity" />
            <!-- metroZONE -->
            <favorite
                launcher:screen="2" 
                launcher:packageName="com.metropcs.metrozone" 
                launcher:className="com.mobileposse.firstapp.MainActivity" />
            <!-- name iD -->
            <favorite
                launcher:screen="3" 
                launcher:packageName="com.privacystar.android.metro" 
                launcher:className="com.tmobile.services.nameid.Startup.IdentifyingNumbersActivity" />
			<!-- Mobile hotspot -->
			<favorite
				launcher:screen="4" 
				launcher:packageName="com.samsung.android.app.mhswrappermtr"
                launcher:className="com.samsung.android.app.mhswrappermtr.MainActivity" />
			<!-- VVM -->
			<favorite
				launcher:screen="5" 
				launcher:packageName="com.metropcs.service.vvm"
                launcher:className="com.tmobile.vvm.application.activity.setup.WelcomeActivity" />
        </folder>
		
        <!-- Settings -->
        <favorite 
            launcher:screen="1" 
            launcher:packageName="com.android.settings" 
            launcher:className="com.android.settings.Settings" 
	        launcher:x="2" 
            launcher:y="4" />
			
        <!-- Lookout -->
        <favorite
            launcher:screen="1" 
            launcher:packageName="com.lookout" 
            launcher:className="com.lookout.ui.LoadDispatch" 
	        launcher:x="3" 
            launcher:y="4" />
					
        <!-- Facebook -->
        <favorite 
            launcher:screen="1"
            launcher:postPosition="true" 
            launcher:packageName="com.facebook.katana" 
            launcher:className="com.facebook.katana.LoginActivity"
            launcher:x="4" 
            launcher:y="4" />
    </home>


    <hotseat>
        <!-- Contacts -->
        <favorite 
            launcher:screen="0" 
            launcher:packageName="com.samsung.android.contacts" 
            launcher:className="com.android.dialer.DialtactsActivity" />

        <!-- Contacts -->
        <favorite 
            launcher:screen="1" 
            launcher:packageName="com.samsung.android.contacts" 
            launcher:className="com.android.contacts.activities.PeopleActivity" />

        <!-- Messages -->
        <favorite 
            launcher:screen="2" 
            launcher:packageName="com.samsung.android.messaging" 
            launcher:className="com.android.mms.ui.ConversationComposer" />

        <!-- Chrome -->
        <favorite 
            launcher:screen="3" 
            launcher:packageName="com.android.chrome" 
            launcher:className="com.google.android.apps.chrome.Main" />

        <!-- Camera -->
        <favorite 
            launcher:screen="4" 
            launcher:packageName="com.sec.android.app.camera" 
            launcher:className="com.sec.android.app.camera.Camera" />

    </hotseat>

</favorites>